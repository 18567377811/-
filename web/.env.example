# Copy to .env / .env.local for local dev. Production: /var/www/feltora/shared/.env

# SQLite — local relative to prisma/ schema dir resolution:
# Prisma resolves file: URLs relative to the schema folder (web/prisma),
# so file:../data/feltora.db → web/data/feltora.db
DATABASE_URL="file:../data/feltora.db"

# Admin console (/admin)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: ImgBB free image host (https://api.imgbb.com). If unset, uploads use Catbox.
# IMGBB_API_KEY=

# https://thestoryofawool.me in production; http://localhost:3000 locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Dashboard → Developers → API keys (use test keys first: sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Dashboard → Developers → Webhooks → Signing secret (whsec_...)
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
