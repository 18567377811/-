# Copy to .env / .env.local for local dev. Production: /var/www/feltora/shared/.env

# SQLite — local relative to prisma/ schema dir resolution:
# Prisma resolves file: URLs relative to the schema folder (web/prisma),
# so file:../data/feltora.db → web/data/feltora.db
DATABASE_URL="file:../data/feltora.db"

# Admin console (/admin)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Local image storage (default: <cwd>/uploads). Production: /var/www/feltora/uploads
# UPLOAD_DIR=

# Optional remote hosts (tried first; on failure falls back to local disk).
# Anonymous Catbox is broken ("Invalid uploader") — only set a userhash if you have an account.
# IMGBB_API_KEY=
# CATBOX_USERHASH=

# Admin auto-translate (zh → en/ms via MyMemory). Optional email raises free quota.
# MYMEMORY_EMAIL=you@example.com

# https://thestoryofawool.me in production; http://localhost:3000 locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayPal (primary checkout) — Developer Dashboard → Apps & Credentials
# Sandbox first; set PAYPAL_MODE=live for production Client ID / Secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox
# Recommended: Webhooks → https://your-domain/api/webhooks/paypal
# Event: PAYMENT.CAPTURE.COMPLETED
# PAYPAL_WEBHOOK_ID=

# Stripe is deprecated / unused in the storefront (kept only for old order records).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
